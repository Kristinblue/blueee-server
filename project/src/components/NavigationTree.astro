---
interface TreeEntry {
  name: string;
  type: "folder" | "note";
  title?: string;
  url?: string;
  children?: TreeEntry[];
}

interface Props {
  entries: TreeEntry[];
}

const { entries } = Astro.props;
---

<ul class="navigation-tree">
  {
    entries.map((entry) =>
      entry.type === "folder" ? (
        <li>
          <details>
            <summary>
              {entry.name}
            </summary>
            <Astro.self entries={entry.children ?? []} />
          </details>
        </li>
      ) : (
        <li>
          <a
            class="note-link"
            href={entry.url}
            data-note-url={entry.url}
            title={entry.title ?? entry.name}
          >
            {entry.title ?? entry.name}
          </a>
        </li>
      ),
    )
  }
</ul>

<style>
  .navigation-tree {
    margin: 0;
    padding-left: 16px;
    list-style: none;
  }

  .navigation-tree .navigation-tree {
    margin-top: 6px;
  }

  li + li {
    margin-top: 5px;
  }

  summary {
    color: var(--sidebar-heading);
    font-weight: 700;
    cursor: default;
    user-select: none;
  }

  .note-link {
    display: block;
    padding: 5px 7px;
    overflow: hidden;
    color: var(--text-muted);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    border-radius: 5px;
  }

  .note-link:hover,
  .note-link[aria-current="page"] {
    color: var(--text-normal);
    background: var(--surface-hover);
  }
</style>
