---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommentSection from "../../components/CommentSection.astro";
import NoteCompanion from "../../components/NoteCompanion.astro";
import notes from "../../generated/notes.json";
import { extractTocTree } from "../../lib/toc";
import "../../styles/markdown.css";

interface Note {
  slug: string;
  title: string;
  description: string;
  html: string;
  sourcePath?: string;
  lastModified?: string;
}

export function getStaticPaths() {
  return (notes as Note[]).map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const tocTree = extractTocTree(note.html, note.title);

// 「contribute」：跳到 blueee-website 仓库里这篇笔记的编辑页，访客用 GitHub 账号
// 即可 fork 并提交 Pull Request；换仓库 / 分支 / 笔记目录时改这一处即可。
const GITHUB_EDIT_BASE =
  "https://github.com/Kristinblue/blueee-website/edit/main/project/src/content/notes";
const encodePath = (value: string) => value.split("/").map(encodeURIComponent).join("/");
const editUrl = note.sourcePath ? `${GITHUB_EDIT_BASE}/${encodePath(note.sourcePath)}` : null;
const formatModified = (iso?: string) => {
  if (!iso) return null;
  const date = new Date(iso);
  const pad = (n: number) => String(n).padStart(2, "0");
  return Number.isNaN(date.getTime()) ? null : `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
};
const modifiedText = formatModified(note.lastModified);

// 碎碎念这两篇里页宠换个形象：投喂站着，使用说明坐着
const COMPANION_IMAGES: Record<string, string> = {
  "碎碎念/投喂": "/media/home/stand_com.gif",
  "碎碎念/使用说明": "/media/home/sit.gif",
};
---

<BaseLayout title={note.title} toc={tocTree} tocTitle={note.title}>
  <main class="note-page">
    <article class="note-article">
      <div class="note-meta">
        {editUrl && (
          <a class="note-edit-link" href={editUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            contribute
          </a>
        )}
        {modifiedText && <span class="note-updated">上次修改：{modifiedText}</span>}
      </div>
      <h1 class="note-title">{note.title}</h1>
      {note.description && <p class="note-description">{note.description}</p>}
      <div class="note-body" set:html={note.html} />
    </article>
    <CommentSection noteSlug={note.slug} />
  </main>
  <NoteCompanion image={COMPANION_IMAGES[note.slug]} />
</BaseLayout>

<style>
  .note-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    margin: 0 0 10px;
  }

  .note-edit-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 13px;
    text-decoration: none;
  }

  .note-edit-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .note-edit-link svg {
    width: 14px;
    height: 14px;
    flex: none;
  }

  .note-updated {
    color: var(--text-muted);
    font-size: 12px;
  }
</style>
